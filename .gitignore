# ============================================================
#  Copias viejas de documentos impresos (sensibles)
# ------------------------------------------------------------
#  GUARDAR_COPIA se quitó en nov-2026; el servidor aún puede tener
#  copias en /archivo hasta que se borren. NUNCA se versionan.
#  Se conserva únicamente el .htaccess que bloquea su descarga.
# ============================================================
/archivo/*
!/archivo/.htaccess

# Pruebas locales (impresora falsa, PDFs de prueba)
/tmp/
*.bin

# Basura del sistema
Thumbs.db
Desktop.ini
.DS_Store
